{
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/thdarkorbit",
    "Audience": "thdarkorbit-api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "unity-api": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/unityApi/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "sas-api": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/Sas/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "project-api": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/ProjectApi/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "index-internal": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/indexInternal.es"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "identity-public": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/v{version}/identity/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "api-protected": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://apiservice/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
