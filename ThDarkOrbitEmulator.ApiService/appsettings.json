{
  "ConnectionStrings": {
    "identity-write": "Host=localhost;Port=5432;Database=thdarkorbit;Username=app;Password=app",
    "identity-read": "Host=localhost;Port=5432;Database=thdarkorbit;Username=app;Password=app"
  },
  "IdentityDatabase": {
    "Schema": "identity",
    "AutoMigrate": true,
    "BackupDirectory": "db-backups",
    "BackupBeforeMigration": true,
    "PgDumpExecutable": "pg_dump",
    "RequireBackupSuccess": false,
    "EnableDockerPgDumpFallback": true,
    "DockerPostgresContainerName": "thdarkorbit-emulator"
  },
  "Cluster": {
    "IsMaster": true,
    "EnableSshSpawner": false,
    "DesiredWorkers": 1
  },
  "FeatureManagement": {
    "Identity.Register": true,
    "Identity.Login": true
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/thdarkorbit",
    "Audience": "thdarkorbit-api",
    "RequireHttpsMetadata": false
  },
  "KeycloakClient": {
    "ClientId": "thdarkorbit-api",
    "ClientSecret": ""
  },
  "KeycloakAdmin": {
    "BaseUrl": "http://localhost:8081",
    "Realm": "thdarkorbit",
    "AdminUsername": "admin",
    "AdminPassword": "admin"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
