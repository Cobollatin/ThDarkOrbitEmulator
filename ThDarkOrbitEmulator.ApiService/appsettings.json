{
  "ConnectionStrings": {
    "identity-write": "Host=localhost;Port=5432;Database=thdarkorbit;Username=app;Password=app",
    "identity-read": "Host=localhost;Port=5433;Database=thdarkorbit;Username=app;Password=app"
  },
  "IdentityDatabase": {
    "Schema": "identity",
    "AutoMigrate": true,
    "BackupDirectory": "db-backups",
    "BackupBeforeMigration": true,
    "PgDumpExecutable": "pg_dump",
    "RequireBackupSuccess": false,
    "EnableDockerPgDumpFallback": true,
    "DockerPostgresContainerName": "postgres"
  },
  "Cluster": {
    "IsMaster": true,
    "EnableSshSpawner": false,
    "DesiredWorkers": 1
  },
  "FeatureManagement": {
    "Identity.Register": true,
    "Identity.Login": true
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/thdarkorbit",
    "Audience": "thdarkorbit-api",
    "RequireHttpsMetadata": false
  },
  "KeycloakClient": {
    "ClientId": "thdarkorbit-api",
    "ClientSecret": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
