{
  "ConnectionStrings": {
    "identity-write": "Host=localhost;Port=5432;Database=thdarkorbit;Username=app;Password=app",
    "identity-read": "Host=localhost;Port=5432;Database=thdarkorbit;Username=app;Password=app"
  },
  "IdentityDatabase": {
    "Schema": "identity",
    "AutoMigrate": true,
    "BackupDirectory": "db-backups",
    "BackupBeforeMigration": false,
    "PgDumpExecutable": "pg_dump",
    "RequireBackupSuccess": false,
    "EnableDockerPgDumpFallback": true,
    "DockerPostgresContainerName": "data-postgres"
  },
  "Cluster": {
    "IsMaster": true,
    "EnableSshSpawner": false,
    "DesiredWorkers": 1,
    "MaxMapsPerNode": 4,
    "HeartbeatIntervalSeconds": 10,
    "LeaseTtlSeconds": 30
  },
  "WorldServer": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 60954,
    "DynamicTcpPort": false,
    "Version": "local-1",
    "MaximumPacketBytes": 65536
  },
  "FeatureManagement": {
    "Identity.Register": true,
    "Identity.Login": true
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/thdarkorbit",
    "Audience": "thdarkorbit-api",
    "RequireHttpsMetadata": false
  },
  "KeycloakClient": {
    "ClientId": "thdarkorbit-api",
    "ClientSecret": ""
  },
  "KeycloakAdmin": {
    "BaseUrl": "http://localhost:8081",
    "Realm": "thdarkorbit",
    "AdminUsername": "admin",
    "AdminPassword": "admin"
  },
  "PlatformOwnerSeed": {
    "Enabled": true,
    "Username": "owner",
    "Password": "owner",
    "Email": "owner@thdarkorbit.local",
    "RealmRole": "emulator-admin"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
